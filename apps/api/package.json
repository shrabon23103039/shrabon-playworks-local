{
  "name": "@playworks/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:cleanup": "tsx src/scripts/cleanup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "argon2": "0.45.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
